@using Microsoft.AspNetCore.Html
@model MoviesAdmin.Models.Movie

@{
    ViewData["Title"] = "Details";
}

<h1>@Html.DisplayFor(model => model.Title)</h1>

<hr />

<div class="row">

    @* Image - appears first on mobile, right on desktop *@
    <div class="col-12 col-md-6 order-1 order-md-2 mb-3">
        <img src="@Model.ImageUrl"alt="@Model.Title"class="img-fluid rounded w-100" />
    </div>

    @* Movie details - appears underneath on mobile, left on desktop *@
    <div class="col-12 col-md-6 order-2 order-md-1">

        <h5>@Html.DisplayNameFor(model => model.Description)</h5>

        @{
            var descriptionWithBreaks = new HtmlString(
                Model.Description
                    .Replace("\r\n", "<br/>")
                    .Replace("\n", "<br/>")
                    .Replace("\r", "<br/>")
            );
        }

        <p>@descriptionWithBreaks</p>

        <hr />

        <div class="row">
            <strong class="col-6">
                @Html.DisplayNameFor(model => model.Genre):
            </strong>

            <p class="col-6 text-end">
                @Html.DisplayFor(model => model.Genre.Title)
            </p>
        </div>

        <div class="row">
            <strong class="col-6">
                @Html.DisplayNameFor(model => model.AudienceRating):
            </strong>

            <p class="col-6 text-end">
                @Html.DisplayFor(model => model.AudienceRating.Title)
            </p>
        </div>

        <div class="row">
            <strong class="col-6">
                @Html.DisplayNameFor(model => model.Reviews):
            </strong>

            <p class="col-6 text-end">
                @Html.DisplayFor(model => model.Reviews.Count)
            </p>
        </div>

        <div class="row">
            <strong class="col-6">
                @Html.DisplayNameFor(model => model.Runtime):
            </strong>

            <p class="col-6 text-end">
                @{
                    int hours = Model.Runtime / 60;
                    int minutes = Model.Runtime % 60;
                }
                @hours h @minutes.ToString("00") min
            </p>
        </div>

        <div class="row">
            <strong class="col-6">
                @Html.DisplayNameFor(model => model.ReleaseDate):
            </strong>

            <p class="col-6 text-end">
                @Html.DisplayFor(model => model.ReleaseDate)
            </p>
        </div>

        <div class="row">
            <strong class="col-6">
                @Html.DisplayNameFor(model => model.CreatedDate):
            </strong>

            <p class="col-6 text-end">
                @Html.DisplayFor(model => model.CreatedDate)
            </p>
        </div>

        @* Display warning if attempting to review twice *@
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger" role="alert">
                @TempData["Error"]
            </div>
        }

    </div>

</div>

<div class="mt-3">
    @if (User.IsInRole("Admin"))
    {
        <a asp-action="Edit" class="btn btn-primary" asp-route-id="@Model?.Id">Edit Movie</a>
    }
    else
    {
        <a asp-controller="CriticReviews" asp-action="Create" asp-route-movieId="@Model?.Id" class="btn btn-primary">Create Review</a>
    }

    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</div>
