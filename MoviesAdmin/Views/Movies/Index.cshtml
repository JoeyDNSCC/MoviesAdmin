@model IEnumerable<MoviesAdmin.Models.Movie>

@{
    ViewData["Title"] = "Index";
}
@* <div class="min-vh-100 min-vw-100 bg-warning-subtle test-dark p-4"> *@
    <h1>All Movies</h1>

    <p>
        <a asp-action="Create" class="btn btn-primary">Add Movie</a>
    </p>
    <table class="table my-table">
        <thead>
            <tr>
                <th>
                    @Html.DisplayNameFor(model => model.Title)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Description)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Genre)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Rating)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Runtime)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.ReleaseDate)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.CreatedDate)
                </th>
                <th></th>
            </tr>
        </thead>
        <tbody>
    @foreach (var item in Model) {
            <tr>
                <td>
                    <div class="title">
                        @Html.DisplayFor(model => item.Title)
                    </div>
                </td>
                <td>
                    <div class="description">
                        @Html.DisplayFor(model => item.Description)
                    </div>
                </td>
                <td>
                    <div class="genre">
                        @Html.DisplayFor(model => item.Genre)
                    </div>
                </td>
                <td>
                    <div class="rating">
                        @Html.DisplayFor(model => item.Rating)
                    </div>
                </td>
                <td>
                    @Html.DisplayFor(model => item.Runtime)
                </td>
                <td>
                    @Html.DisplayFor(model => item.ReleaseDate)
                </td>
                <td>
                    @Html.DisplayFor(model => item.CreatedDate)
                </td>
                <td>
                    <div class="actions">
                        <a asp-action="Edit" class="btn btn-primary btn-sm" asp-route-id="@item.Id">Edit</a>
                        <a asp-action="Details" class="btn btn-primary btn-sm" asp-route-id="@item.Id">Details</a>
                        <a asp-action="Delete" class="btn btn-primary btn-sm" asp-route-id="@item.Id">Delete</a>
                    </div>
                </td>
            </tr>
    }
        </tbody>
    </table>
@* </div> *@