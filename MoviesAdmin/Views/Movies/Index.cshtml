@model IEnumerable<MoviesAdmin.Models.Movie>

@{
    ViewData["Title"] = "Index";
}
@* <div class="min-vh-100 min-vw-100 bg-warning-subtle test-dark p-4"> *@
    <h1>All Movies</h1>

    @if (User.IsInRole("Admin"))
    {
        <p>
            <a asp-action="Create" class="btn btn-primary">Add Movie</a>
        </p>
    }

    @* TO-DO: add search bar *@
    
<table class="table my-table">
        <thead>
            <tr>
                <th>
                    @* Sort By: *@
                </th>

                <th> @*call view onclick to refresh page & send the string thru param*@
                    <a asp-action="Index" asp-route-sortOrder="@ViewData["TitleSort"]" class="table-header">
                        @Html.DisplayNameFor(model => model.Title)
                    </a>
                </th>
                <th>
                    <a asp-action="Index" asp-route-sortOrder="@ViewData["GenreSort"]" class="table-header">
                        @Html.DisplayNameFor(model => model.Genre)
                    </a>
                </th>
                <th>
                    <a asp-action="Index" asp-route-sortOrder="@ViewData["RatingSort"]" class="table-header">
                        @Html.DisplayNameFor(model => model.AudienceRating)
                    </a>
                </th>
                <th>
                    <a asp-action="Index" asp-route-sortOrder="@ViewData["RuntimeSort"]" class="table-header">
                        @Html.DisplayNameFor(model => model.Runtime)
                    </a>
                </th>
                <th>
                    <a asp-action="Index" asp-route-sortOrder="@ViewData["ReleaseDateSort"]" class="table-header">
                        @Html.DisplayNameFor(model => model.ReleaseDate)
                    </a>
                </th>
                <th>
                    <a asp-action="Index" asp-route-sortOrder="@ViewData["CreatedDateSort"]" class="table-header">
                        @Html.DisplayNameFor(model => model.CreatedDate)
                    </a>
                </th>

                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
    @foreach (var item in Model) {
            <tr>
                <td class="index-cell">
                    <img src="@item.ImageUrl" alt="@item.Title" class="thumbnail" />
                </td>
                <td class="index-cell">
                        @Html.DisplayFor(model => item.Title)
                </td>


                <td class ="index-cell">
                    @Html.DisplayFor(model => item.Genre.Title)
                </td>
                <td class="index-cell">
                    @Html.DisplayFor(model => item.AudienceRating.Title)
                </td>


                @*runtime math here*@
                <td class="index-cell">
                    @{
                        int hours = item.Runtime / 60;
                        int minutes = item.Runtime % 60;
                    }
                    @hours h @minutes.ToString("00") min
                </td>
                <td class="index-cell">
                    @Html.DisplayFor(model => item.ReleaseDate)
                </td>
                <td class="index-cell">
                    @Html.DisplayFor(model => item.CreatedDate)
                </td>
                <td>
                    <div class="actions">
                        @if(User.IsInRole("Admin"))
                        {
                            <a asp-action="Edit" class="btn btn-primary btn-sm mb-1" asp-route-id="@item.Id">Edit</a>
                            <a asp-action="Details" class="btn btn-primary btn-sm mb-1" asp-route-id="@item.Id">Details</a>
                            <a asp-action="Delete" class="btn btn-primary btn-sm" asp-route-id="@item.Id">Delete</a>
                        } else
                        {
                            <a asp-action="Details" class="btn btn-primary mb-2" asp-route-id="@item.Id">Details</a>
                            <a asp-controller="CriticReviews" asp-action="Create" asp-route-movieId="@item?.Id" class="btn btn-primary">Create Review</a>
                        }
                    </div>
                </td>
            </tr>
    }
        </tbody>
    </table>
@* </div> *@