<div class="mb-3">
    <label class="control-label mb-2">Image Upload</label>

    <div class="drop-zone" id="imageDropZone">
        <input type="file"
               id="ImageFile"
               name="imageFile"
               accept="image/*"
               hidden />

        <div class="drop-zone-content">
            <i class="bi bi-cloud-arrow-up"></i>
            <h5>Drag & Drop an Image Here</h5>
            <p>or <span>browse</span> to choose a file</p>
            <small>Image files only</small>
        </div>
    </div>

    <div id="selectedImage" class="selected-image mt-2"></div>

    @Html.ValidationMessage("imageFile", new { @class = "text-danger" })
</div>
