@model MoviesAdmin.Models.Movie

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>Movie</h4>
<hr />
<div class="row">
    <div class="col-md-5">
        <form asp-action="Create" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-2">
                <label asp-for="Title" class="control-label"></label>
                <input asp-for="Title" class="form-control" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>

            <div class="mb-2">
                <label asp-for="Description" class="control-label"></label>
                <textarea asp-for="Description" class="form-control" rows="5"></textarea>
                @* <input asp-for="Description" class="form-control" /> *@
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="GenreId" class="control-label"></label>
                <select asp-for="GenreId" class="form-select" asp-items="ViewBag.GenreId"></select> 
            </div>

            <div class="mb-3">
                <label asp-for="AudienceRatingId" class="control-label"></label>
                <select asp-for="AudienceRatingId" class="form-select" asp-items="ViewBag.AudienceRatingId"></select>
            </div>


            <div class="mb-2">
            <label asp-for="Runtime" class="control-label"></label> (min)
                <input asp-for="Runtime" class="form-control" />
                <span asp-validation-for="Runtime" class="text-danger"></span>
            </div>

            <div class="mb-2">
                <label asp-for="ReleaseDate" class="control-label"></label>
                <input asp-for="ReleaseDate" class="form-control" />
                <span asp-validation-for="ReleaseDate" class="text-danger"></span>
            </div>

            @* <div class="mb-3">
                <label asp-for="CreatedDate" class="form-label"></label>
                <input asp-for="CreatedDate" hidden class="form-control" />
                <span asp-validation-for="CreatedDate" class="text-danger"></span>
            </div> *@

            @*
            TO-DO: add drop area for drag&dropping files
            *@
            <div class="mb-2">
                <label class="control-label">Image Upload</label>
                <input type="file" id="ImageFile" name="ImageFile" class="form-control"/>
                @Html.ValidationMessage("ImageFile", new  { @class="text-danger" })
            </div>

            

            <div>
                <input type="submit" value="Create" class="btn btn-primary" />

                <a asp-action="Index" class="btn btn-secondary">Back to List</a>
            </div>
        </form>
    </div>
</div>


