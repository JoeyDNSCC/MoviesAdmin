@model MoviesAdmin.Models.Movie

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit Movie</h1>

<hr />
<div class="row">

    <div class="col-12 col-md-6 order-1 order-md-2 mb-3">
        <div>
            <img id="movieImagePreview" src="@Model.ImageUrl" alt="@Model.Title" class="w-100 img-fluid img-thumbnail" />
        </div>
    </div>

    <div class="col 12 col order-2 order-md-1">
        <form asp-action="Edit" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="ImageUrl" />
            <input type="hidden" asp-for="CreatedDate" />

            <div class="mb-3">
                <label asp-for="Title" class="form-label"></label>
                <input asp-for="Title" class="form-control" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="GenreId" class="form-label">Genre</label>
                <select asp-for="GenreId" class="form-select" asp-items="ViewBag.GenreId"></select>
            </div>
            <div class="mb-3">
                <label asp-for="AudienceRatingId" class="form-label">Rating</label>
                <select asp-for="AudienceRatingId" class="form-select" asp-items="ViewBag.AudienceRatingId"></select>
            </div>
            <div class="mb-3">
                <label asp-for="Runtime" class="form-label"></label> (min)
                <input asp-for="Runtime" class="form-control" />
                <span asp-validation-for="Runtime" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="ReleaseDate" class="form-label"></label>
                <input asp-for="ReleaseDate" class="form-control" />
                <span asp-validation-for="ReleaseDate" class="text-danger"></span>
            </div>




            <div class="mb-3">
                <partial name="_ImageDropZone" />
            </div>


            <div class="mb-3">
                <input type="submit" value="Save" class="btn btn-primary" />

                <a asp-action="Index" class="btn btn-secondary">Back to List</a>
            </div>
        </form>
    </div>
</div>



@section Scripts {
    <script src="~/js/image-dropzone.js"></script>

    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
