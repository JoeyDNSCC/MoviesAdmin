@model List<MoviesAdmin.Models.Movie>

@{
    ViewData["Title"] = "All Movies";
}

<h1>
    All Trails
</h1>

<p>
    @Model.Count trails.
</p>

@foreach(var movie in Model)
{
    <h2>
        @movie.Title
    </h2>

    <p>
        Runtime: @movie.Runtime m<br />
        Rating: @movie.Rating<br />
        Genre: @movie.Genre
    </p>

    <p>
        @movie.Description
    </p>
}