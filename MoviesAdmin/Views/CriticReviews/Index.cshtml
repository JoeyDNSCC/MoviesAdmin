@model IEnumerable<MoviesAdmin.Models.CriticReview>

@{
    ViewData["Title"] = "Index";
}

<h1>My Reviews</h1>

<p>
    <a asp-controller="Movies" asp-action="Index" class="btn btn-primary">To Movies</a>
</p>


<h4>Drafts</h4>
<table class="table my-table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Movie)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Rating)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CreatedDate)
            </th>
            <th>
                Actions
            </th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Where(w => !w.IsPublished))
        {
            <tr>
                <td>
                    @Html.DisplayFor(model => item.Movie.Title)
                </td>

                <td>
                    @Html.DisplayFor(model => item.Rating)
                </td>
                <td>
                    @Html.DisplayFor(model => item.CreatedDate)
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-primary btn-sm">Edit</a>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-primary btn-sm">Details</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-primary btn-sm">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>


<h4>Published</h4>
<table class="table my-table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Movie)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Rating)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CreatedDate)
            </th>
            <th>
                Actions
            </th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Where(w => w.IsPublished)) 
        {
            <tr>
                <td>
                    @Html.DisplayFor(model => item.Movie.Title)
                </td>

                <td>
                    @Html.DisplayFor(model => item.Rating)
                </td>
                <td>
                    @Html.DisplayFor(model => item.CreatedDate)
                </td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-primary btn-sm">Details</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-primary btn-sm">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

