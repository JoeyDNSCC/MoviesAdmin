@model MoviesAdmin.Models.CriticReview

@{
    ViewData["Title"] = "Create";
}

<h1>Create Review</h1>

<hr />
<div class="row">

    <div class="col-12 col-md-6 order-1 order-md-2 mb-3">
        @* <img src="@Model.Movie.ImageUrl" alt="@Model.Movie.Title" class="img-fluid rounded w-100" /> *@
    </div>

    <div class="col-md-5">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <input type="hidden" asp-for="MovieId" value="@ViewBag.MovieId" />
                

            <div class="mb-3">
                <label asp-for="Description" class="control-label"></label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Rating" class="control-label">Rating (1-5)</label>
                <input asp-for="Rating" class="form-control" />
                <span asp-validation-for="Rating" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="IsPublished" class="control-label">Publish Now?</label>
                <input asp-for="IsPublished" class="form-check-input" />
                <span asp-validation-for="IsPublished" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <input type="submit" value="Create" class="btn btn-primary" />
                <a asp-controller="Movies" asp-action="Index" class="btn btn-secondary">Back to List</a>
            </div>

        </form>
    </div>
</div>

<div>
    
</div>
